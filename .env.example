# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ENABLE_SWAGGER=true   # set to "false" in production if the API surface shouldn't be publicly browsable
ADMIN_APP_URL=http://localhost:5174   # base URL the staff-invite link points at

# Database (points at PgBouncer, not Postgres directly — see docker-compose.yml)
DATABASE_URL=postgres://kilo:kilo_dev_password@localhost:6432/kilo?pgbouncer=true
# Direct connection, bypassing PgBouncer — required for `prisma migrate` (shadow DB, session-level locks)
DIRECT_URL=postgres://kilo:kilo_dev_password@localhost:5432/kilo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_me
JWT_REFRESH_EXPIRES_IN=30d

# Social login (rider app only) — see README for where to get these
# Comma-separated: every OAuth client ID your rider apps sign in with (iOS + Android + web, as applicable)
GOOGLE_OAUTH_CLIENT_IDS=
# Apple "Services ID" identifier (or bundle ID) registered for Sign in with Apple
APPLE_CLIENT_ID=

# Third-party — see kilo-backend-plan.md Section 3
GOOGLE_MAPS_API_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
TERMII_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
# Must be a domain verified in Resend, or sending fails — defaults to
# Resend's no-setup-required onboarding@resend.dev if left blank
EMAIL_FROM=
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=

# Object storage (Cloudflare R2 — S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket (public bucket or a custom CDN domain).
# When set, uploaded avatars are stored as a stable public URL; otherwise
# a long-lived signed URL is used as a fallback.
R2_PUBLIC_BASE_URL=

# Observability
SENTRY_DSN=
